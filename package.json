{
  "name": "wish-web",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "description": "Web and mobile client for the Wish agent server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WindustH/wish-web.git"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "fonts": "python3 tools/fonts.py",
    "dev": "python3 tools/fonts.py && vite --host 127.0.0.1",
    "build": "python3 tools/fonts.py && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "start": "node serve.ts",
    "selftest:api": "node ../wish-test/web/run.mjs api",
    "test": "node ../wish-test/web/run.mjs unit",
    "lint": "node ../wish-test/web/run.mjs boundaries",
    "format": "prettier --write src serve.ts vite.config.ts",
    "format:check": "prettier --check src serve.ts vite.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@fontsource-variable/bitter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@lobehub/icons-static-svg": "1.95.0",
    "@mdit/plugin-tex": "1.1.1",
    "@tanstack/vue-virtual": "3.13.37",
    "@tauri-apps/api": "^2.12.5",
    "@tokenizer/range": "0.13.1",
    "@xterm/addon-fit": "0.12.0-beta.334",
    "@xterm/addon-image": "0.10.0-beta.333",
    "@xterm/addon-unicode11": "0.10.0-beta.332",
    "@xterm/xterm": "6.1.0-beta.338",
    "dompurify": "3.4.15",
    "echarts": "6.1.0",
    "highlight.js": "11.12.0",
    "html-to-image": "1.11.13",
    "html2canvas": "1.4.1",
    "markdown-it": "15.0.1",
    "motion-v": "2.5.0",
    "music-metadata": "12.3.2",
    "pdfjs-dist": "6.4.299",
    "reka-ui": "2.10.4",
    "restty": "0.3.0",
    "ssh2": "1.17.0",
    "temml": "0.13.5",
    "vue": "3.5.42",
    "vue-router": "4.6.4",
    "wraithterm": "0.6.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.2",
    "@types/postcss-pxtorem": "6.1.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-vue": "6.0.8",
    "postcss-pxtorem": "6.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vue-tsc": "3.3.11",
    "workbox-window": "7.4.1"
  }
}
