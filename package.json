{
  "name": "wish-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Web and mobile client for the Wish agent server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WindustH/wish-web.git"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "start": "node serve.ts",
    "selftest:api": "node tools/selftest-api.ts",
    "test": "node --test tools/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@fontsource-variable/bitter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@lobehub/icons-static-svg": "1.95.0",
    "@lucide/vue": "1.43.0",
    "@mdit/plugin-tex": "1.1.1",
    "@tanstack/vue-virtual": "3.13.37",
    "dompurify": "3.4.15",
    "echarts": "6.1.0",
    "markdown-it": "15.0.1",
    "reka-ui": "2.10.4",
    "temml": "0.13.5",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.2",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vue-tsc": "3.3.11",
    "workbox-window": "7.4.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "@tanstack/virtual-core@3.17.9": "patches/@tanstack__virtual-core@3.17.9.patch"
    }
  }
}
