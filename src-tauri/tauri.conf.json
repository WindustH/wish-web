{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wish",
  "version": "../package.json",
  "identifier": "io.github.windusth.wish",
  "build": {
    "beforeDevCommand": { "script": "node tools/native-assets.mjs", "wait": true },
    "beforeBuildCommand": "node tools/native-assets.mjs && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wish",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
